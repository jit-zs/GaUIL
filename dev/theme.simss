{

    border_color: rgb(25, 75, 196);
    background_color: rgb(57, 57, 57);
    text_color: rgb(255, 244, 244);
    
    font: "Orange Juice";
    padding: 1;
    
    radius: 10000;
}
panel{
    background_color: rgb(100, 100, 100);
    radius: 2;
}
bear{
    font: "Wedgie";
}

subrect{
    background_color: rgb(255, 128, 128);
    border_color: rgb(55, 11, 11);
    radius: 2;
}

button|hover{
    background_color: rgb(84, 84, 84);
}
slider{
    padding: 2;
    radius: 1000;
    border_color: rgb(200, 200, 200);
    background_color: rgb(255, 255, 255);
}
slider_handle{
    radius: 1000;
    border_color: rgb(170, 170, 170);
    background_color: rgb(150, 150, 150);
    margin_bottom: 20;
}

flat_slider{
    
}

window{
    title_bar_height: 32;
}


check_box{
    radius: 0;
    padding: 10;
}
options.label{
    padding: 5;
    horizontal_alignment: "left";
}
check_box|active{
    padding: 5;
}
check{
    radius: 0;
    background_color: frgb(1, 1, 1);
    border_color: frgb(1, 1, 1);
}
check|hover{
    radius: 4;
}
check|active{
    radius: 4;
}



back{
    radius: 0;
    radius_bottom_right: 10000;
    background_color: rgba(25, 75, 196, 128);
}